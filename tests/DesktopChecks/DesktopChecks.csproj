<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PdfMB.Desktop/PdfMB.Desktop.csproj" />
    <Compile Include="../../src/PdfMB.Desktop/Services/PdfAssociation.cs" Link="PdfAssociation.cs" />
    <Compile Include="../../src/PdfMB.Desktop/Services/PdfDropFiles.cs" Link="PdfDropFiles.cs" />
    <Compile Include="../../src/PdfMB.Desktop/Services/PngFile.cs" Link="PngFile.cs" />
    <Compile Include="../../src/PdfMB.Desktop/Services/StampLibrary.cs" Link="StampLibrary.cs" />
    <Compile Include="../../src/PdfMB.Desktop/Services/PdfFile.cs" Link="PdfFile.cs" />
    <Compile Include="../../src/PdfMB.Desktop/Services/MarkdownFile.cs" Link="MarkdownFile.cs" />
    <Compile Include="../../src/PdfMB.Desktop/Services/OllamaOcr.cs" Link="OllamaOcr.cs" />
    <Compile Include="../../src/PdfMB.Desktop/Services/UpdateChecker.cs" Link="UpdateChecker.cs" />
  </ItemGroup>
  <Target Name="RemoveUnusedWpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
