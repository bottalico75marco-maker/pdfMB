{
  "name": "pdfmb-desktop",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "check": "npm test && dotnet build PdfMB.sln -c Release --nologo && dotnet run --project tests/DesktopChecks -c Release",
    "release:check": "pwsh ./scripts/prepare-release.ps1 -MetadataOnly"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/snippet": "2.15.1",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "playwright": "1.64.1"
  }
}
